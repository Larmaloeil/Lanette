{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanette",
  "version": "1.3.0",
  "identifier": "fr.larma.lanette",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lanette",
        "width": 820,
        "height": 560,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "skipTaskbar": false,
        "dragDropEnabled": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: icon: http://icon.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Larma",
    "shortDescription": "Lanceur d'applications",
    "longDescription": "Lanette regroupe vos programmes, raccourcis, dossiers, fichiers et liens dans une seule fenêtre.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
